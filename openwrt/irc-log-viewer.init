#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/local/bin/irc-log-viewer
CONF=/etc/irc-log-viewer.yaml
RUN_AS=znc

# The value of the first "key:" line in $CONF, quotes and trailing comment removed.
conf_value() {
	awk -v key="$1" '
		$1 == key ":" {
			sub(/^[^:]*:[ \t]*/, ""); sub(/[ \t]+#.*$/, ""); gsub(/^["'\'']|["'\'']$/, "")
			print; exit
		}' "$CONF"
}

# A directory the viewer writes: created and handed to $RUN_AS before it is
# mounted, since ujail cannot bind a missing path and the process is not root.
mount_rw_dir() {
	[ -n "$1" ] || return 0
	mkdir -p "$1" || return 1
	chown "$RUN_AS:$RUN_AS" "$1"
	procd_add_jail_mount_rw "$1"
}

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_set_param user "$RUN_AS"
	procd_set_param nice 5
	procd_set_param limits core="0" as="262144000"

	procd_add_jail irc-log-viewer log
	procd_add_jail_mount "$CONF"
	# The Anthropic client verifies TLS against the system trust store.
	procd_add_jail_mount /etc/ssl/certs

	# Mount log dirs (read-only) and output dir (read-write) from YAML config
	for dir in $(awk '/^logs_dirs:/{p=1;next} p && /^[^-]/{exit} p{print $2}' "$CONF"); do
		procd_add_jail_mount "$dir"
	done

	mount_rw_dir "$(conf_value output_dir)"

	# The index is replaced by a rename, so its whole directory is mounted.
	index_path=$(conf_value index_path)
	[ -n "$index_path" ] && mount_rw_dir "$(dirname "$index_path")"

	# The ZNC client certificate and key, read at startup.
	client_cert=$(conf_value client_cert)
	[ -n "$client_cert" ] && procd_add_jail_mount "$client_cert"

	# OpenGraph cards are cached one file per URL, each replaced by a rename.
	mount_rw_dir "$(conf_value cache_dir)"

	procd_close_instance
}

# No stop_service(): it runs before procd marks the instance halted, so killing
# the process there looks like a crash and respawn restarts it.

service_triggers() {
	procd_add_reload_trigger irc-log-viewer
}
